# Research Intelligence Engine - local settings (DO NOT COMMIT)

DATABASE_PATH=data/research_intel.db
BRIEFS_DIR=data/briefs
TIMEZONE=America/New_York

ARTICLE_KEEP_DAYS=21
BRIEF_KEEP_DAYS=90
BRIEF_FILES_KEEP=4

# Required only if you want the brief emailed. Leave blank to write files only.
EMAIL_TO=
EMAIL_APP_PASSWORD=
# Optional. Defaults to EMAIL_TO.
EMAIL_FROM=
EMAIL_USERNAME=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true

# Optional. The brief runs from RSS with all of these empty.
# Guardian: https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=
# NewsAPI: https://newsapi.org/register
NEWS_API_KEY=
# NYT: https://developer.nytimes.com/
NYT_API_KEY=
# TMDB movies (now playing / upcoming). https://www.themoviedb.org/settings/api
TMDB_API_KEY=
